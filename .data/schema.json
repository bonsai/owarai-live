{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OWARAI MUSEN Asset",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "sources",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "provider",
        "venue_complex",
        "venue",
        "organizer",
        "performer",
        "event_series",
        "event",
        "ticket",
        "source"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attributes": {
      "type": "object"
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "target"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "confidence": {
      "enum": [
        "source_confirmed",
        "seed",
        "candidate",
        "official_source",
        "official"
      ]
    }
  },
  "additionalProperties": true
}
